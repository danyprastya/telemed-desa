# Supabase — safe to expose to browser (used in client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_
# This key bypasses ALL RLS. It is only ever imported in lib/supabase/server.ts and /app/api/**
SUPABASE_SERVICE_ROLE_KEY=

# App URL — used for redirects and PWA
NEXT_PUBLIC_APP_URL=http://localhost:3000
